#include "./inc/app.hpp"
#include "inc/ohm_calc.hpp"

using namespace app;

int main(int argc, char *argv[])
{
  // CLI Parser ---
  Args args;
  bool cli_status = parseCLI(argc, argv, args);
  if (!cli_status)
    return 1;
  // Calculations ---
  OhmCalc calc(args.v.value_or(-1), args.i.value_or(-1), args.r.value_or(-1), args.p.value_or(-1));
  calc.print_result();
  //
  return 0;
}
